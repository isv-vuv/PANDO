<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" default-locale="en-GB">
  <info>
    <title>VuV - Author-Date (Compact)</title>
    <id>http://www.zotero.org/styles/vuv-author-date-compact</id>
    <link href="http://www.zotero.org/styles/vuv-author-date-compact" rel="self"/>
    <author>
      <name>ISV VuV YR</name>
    </author>
    <category citation-format="author-date"/>
    <category field="generic-base"/>
    <updated>2026-04-01T10:15:00+02:00</updated>
  </info>

<locale xml:lang="en">
    <terms>
      <term name="retrieved">retrieved on</term>
      <term name="online">Retrieved from</term>
    </terms>
  </locale>

  <macro name="editor">
    <names variable="editor" delimiter=", ">
      <name name-as-sort-order="all" sort-separator=" " initialize-with=" " delimiter=", " delimiter-precedes-last="always"/>
      <label form="short" prefix=" (" suffix=")"/>
    </names>
  </macro>

  <macro name="author">
    <choose>
      <if variable="author">
        <names variable="author">
          <name name-as-sort-order="all" sort-separator=" " initialize-with=" " delimiter=", " delimiter-precedes-last="always"/>
        </names>
      </if>
      <else-if variable="editor">
        <names variable="editor">
          <name name-as-sort-order="all" sort-separator=" " initialize-with=" " delimiter=", " delimiter-precedes-last="always"/>
          <label form="short" prefix=" (" suffix=")"/>
        </names>
      </else-if>
      <else-if variable="contributor">
        <names variable="contributor">
          <name name-as-sort-order="all" sort-separator=" " initialize-with=" " delimiter=", " delimiter-precedes-last="always"/>
        </names>
      </else-if>
      <else>
        <text variable="title"/>
      </else>
    </choose>
  </macro>

  <macro name="author-sort">
    <names variable="author">
      <name/>
      <substitute>
        <names variable="editor"/>
        <names variable="contributor"/>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>

  <macro name="author-short">
    <names variable="author">
      <name form="short" and="text" delimiter=", " initialize-with=" "/>
      <substitute>
        <names variable="editor">
          <name form="short" and="text" delimiter=", " initialize-with=" "/>
        </names>
        <names variable="contributor">
          <name form="short" and="text" delimiter=", " initialize-with=" "/>
        </names>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>

  <macro name="legislation-authorities">
    <names variable="author">
      <name and="text" delimiter=" and "/>
      <substitute>
        <names variable="editor">
          <name and="text" delimiter=" and "/>
        </names>
        <names variable="contributor">
          <name and="text" delimiter=" and "/>
        </names>
      </substitute>
    </names>
  </macro>

  <macro name="primary-sort-key">
    <text macro="author-sort"/>
  </macro>

  <macro name="access">
    <group delimiter=" ">
      <text term="online" text-case="capitalize-first"/>
      <text variable="URL"/>
      <group prefix=" (" suffix=")">
        <text term="retrieved" text-case="lowercase" suffix=" "/>
        <date variable="accessed">
          <date-part name="day" form="numeric-leading-zeros" suffix="."/>
          <date-part name="month" form="numeric-leading-zeros" suffix="."/>
          <date-part name="year"/>
        </date>
      </group>
    </group>
  </macro>
  
  <macro name="url-access">
    <choose>
      <if variable="DOI">
        </if>
      <else-if variable="URL">
        <group delimiter=" " prefix=". ">
          <text term="online" text-case="capitalize-first"/>
          <text variable="URL"/>
          <group prefix=" (" suffix=")">
            <text term="retrieved" text-case="lowercase" suffix=" "/>
            <date variable="accessed">
              <date-part name="day" form="numeric-leading-zeros" suffix="."/>
              <date-part name="month" form="numeric-leading-zeros" suffix="."/>
              <date-part name="year"/>
            </date>
          </group>
        </group>
      </else-if>
    </choose>
  </macro>

  <macro name="title">
    <text variable="title"/>
  </macro>

  <macro name="publisher">
    <group delimiter=". ">
      <text variable="publisher"/>
      <text variable="publisher-place"/>
    </group>
  </macro>

  <macro name="year-date">
    <choose>
      <if variable="issued">
        <date variable="issued">
          <date-part name="year"/>
        </date>
      </if>
      <else>
        <text term="no date" form="short"/>
      </else>
    </choose>
  </macro>

  <macro name="event">
    <group delimiter=", ">
      <text variable="event"/>
      <text variable="event-place"/>
    </group>
  </macro>

  <macro name="identifiers-prioritized">
    <choose>
      <if variable="DOI">
        <group delimiter=" ">
          <text value="DOI"/>
          <text variable="DOI"/>
        </group>
      </if>
      <else-if variable="ISBN">
        <group delimiter=" ">
          <text value="ISBN"/>
          <text variable="ISBN"/>
        </group>
      </else-if>
      <else-if variable="ISSN">
        <group delimiter=" ">
          <text value="ISSN"/>
          <text variable="ISSN"/>
        </group>
      </else-if>
    </choose>
  </macro>

  <citation et-al-min="3" et-al-use-first="1" disambiguate-add-year-suffix="true" disambiguate-add-names="true" disambiguate-add-givenname="true" collapse="year">
    <sort>
      <key macro="primary-sort-key"/>
      <key macro="year-date"/>
    </sort>
    <layout prefix="(" suffix=")" delimiter=", ">
      <group delimiter=", ">
        <group delimiter=" ">
          <text macro="author-short"/>
          <text macro="year-date"/>
        </group>
        <text variable="locator"/>
      </group>
    </layout>
  </citation>

  <bibliography hanging-indent="true" et-al-min="1000" et-al-use-first="1000">
    <sort>
      <key macro="primary-sort-key"/>
      <key macro="year-date"/>
    </sort>
    <layout suffix=".">
      <choose>
        <if type="legislation">
          <group delimiter=" ">
            <group delimiter=" ">
              <text macro="legislation-authorities"/>
              <group prefix="(" suffix=")">
                <text macro="year-date"/>
              </group>
            </group>
            <group>
              <text variable="title"/>
              <choose>
                <if variable="title-short">
                  <text variable="title-short" prefix=" (" suffix=")"/>
                </if>
              </choose>
            </group>
          </group>
          <group prefix=". " delimiter=". ">
            <text variable="number"/>
            <text variable="container-title"/>
            <text variable="page"/>
          </group>
        </if>
        <else>
          <group delimiter=" ">
            <text macro="author"/>
            <group prefix=" (" suffix=")">
              <text macro="year-date"/>
            </group>
            <choose>
              <if variable="author editor contributor" match="any">
                <text macro="title" prefix=" "/>
              </if>
            </choose>
          </group>
          <choose>
            <if type="book">
              <group prefix=". " delimiter=". ">
                <group delimiter=" ">
                  <choose>
                    <if variable="author">
                      <text macro="editor"/>
                    </if>
                  </choose>
                  <text variable="edition"/>
                </group>
                <group delimiter=". ">
                  <text variable="collection-title"/>
                  <text variable="collection-number"/>
                </group>
                <group delimiter=" ">
                  <text term="volume" form="short" text-case="capitalize-first"/>
                  <text variable="volume"/>
                </group>
                <text macro="publisher"/>
              </group>
            </if>
            <else-if type="report">
			  <group prefix=". " delimiter=". ">
			  <text variable="publisher"/> 
			  <text variable="publisher-place"/> 
			    </group>
			  </else-if>
            <else-if type="chapter">
              <group prefix=". " delimiter=". ">
                <group>
                  <text term="in" text-case="capitalize-first" suffix=": "/>
                  <text macro="editor" suffix=" "/>
                  <text variable="container-title"/>
                </group>
                <text variable="page"/>
              </group>
              <text macro="publisher" prefix=". "/>
            </else-if>
            <else-if type="paper-conference">
              <group prefix=". " delimiter=". ">
                <group>
                  <text term="in" text-case="capitalize-first" suffix=": "/>
                  <text macro="editor" suffix=" "/>
                  <text variable="container-title"/>
                </group>
                <text macro="event"/>
                <text variable="page"/>
              </group>
              <text macro="publisher" prefix=". "/>
            </else-if>
            <else-if type="article-journal">
              <group prefix=". " delimiter=". ">
                <text variable="container-title"/>
                <group delimiter=" ">
                  <text variable="volume"/>
                  <group prefix="(" suffix=")">
                    <text variable="issue"/>
                  </group>
                </group>
                <text variable="page"/>
              </group>
            </else-if>
            <else-if type="thesis">
              <group prefix=". " delimiter=". ">
                <text variable="genre" font-style="italic"/>
                <text macro="publisher"/>
              </group>
            </else-if>
            <else-if type="webpage">
              <group prefix=". " delimiter=", ">
                <text variable="container-title"/>
              </group>
            </else-if>
            <else-if type="software">
              <group prefix=" " delimiter=" ">
                <group prefix="(" suffix=")">
                  <text value="Version" suffix=" "/>
                  <text variable="version"/>
                </group>
                <text value="[Software]"/>
              </group>
              <group prefix=". " delimiter=". ">
                <text variable="medium"/>
                <text variable="publisher-place"/>
              </group>
            </else-if>
          </choose>
        </else>
      </choose>
      <text macro="identifiers-prioritized" prefix=". "/>
      <text macro="url-access"/>
    </layout>
  </bibliography>
</style>