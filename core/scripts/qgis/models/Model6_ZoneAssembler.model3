    <Option name="native:fieldcalculator_3" type="Map">
      <Option name="active" type="bool" value="true"/>
      <Option name="alg_config"/>
      <Option name="alg_id" type="QString" value="native:fieldcalculator"/>
      <Option name="color" type="QString" value=""/>
      <Option name="comment" type="Map">
        <Option name="color" type="QString" value=""/>
        <Option name="component_description" type="QString" value=""/>
        <Option name="component_height" type="double" value="60"/>
        <Option name="component_pos_x" type="double" value="4330"/>
        <Option name="component_pos_y" type="double" value="3295"/>
        <Option name="component_width" type="double" value="100"/>
        <Option name="outputs_collapsed" type="bool" value="true"/>
        <Option name="parameters_collapsed" type="bool" value="true"/>
      </Option>
      <Option name="component_description" type="QString" value="Field calculator: TypeNo0"/>
      <Option name="component_height" type="double" value="30"/>
      <Option name="component_pos_x" type="double" value="580"/>
      <Option name="component_pos_y" type="double" value="1365"/>
      <Option name="component_width" type="double" value="200"/>
      <Option name="dependencies"/>
      <Option name="id" type="QString" value="native:fieldcalculator_3"/>
      <Option name="outputs"/>
      <Option name="outputs_collapsed" type="bool" value="true"/>
      <Option name="parameters_collapsed" type="bool" value="true"/>
      <Option name="params" type="Map">
        <Option name="FIELD_LENGTH" type="List">
          <Option type="Map">
            <Option name="source" type="int" value="2"/>
            <Option name="static_value" type="int" value="0"/>
          </Option>
        </Option>
        <Option name="FIELD_NAME" type="List">
          <Option type="Map">
            <Option name="source" type="int" value="2"/>
            <Option name="static_value" type="QString" value="TypeNo"/>
          </Option>
        </Option>
        <Option name="FIELD_PRECISION" type="List">
          <Option type="Map">
            <Option name="source" type="int" value="2"/>
            <Option name="static_value" type="int" value="0"/>
          </Option>
        </Option>
        <Option name="FIELD_TYPE" type="List">
          <Option type="Map">
            <Option name="source" type="int" value="2"/>
            <Option name="static_value" type="int" value="1"/>
          </Option>
        </Option>
        <Option name="FORMULA" type="List">
          <Option type="Map">
            <Option name="source" type="int" value="2"/>
            <Option name="static_value" type="QString" value="CASE&#xd;&#xa;  -- 1. GRID COMPETITION: Grid cells compete via Total_Intensity within 50km&#xd;&#xa;  WHEN &quot;Point_Src&quot; = 'Grid' AND &quot;Target_Tier&quot; = 0 AND &#xd;&#xa;       aggregate(&#xd;&#xa;         layer:=@layer,&#xd;&#xa;         aggregate:='count',&#xd;&#xa;         expression:=&quot;ZONENO&quot;,&#xd;&#xa;         filter:=&quot;Point_Src&quot; = 'Grid' AND &quot;Target_Tier&quot; = 0 AND &quot;Total_Intensity&quot; > attribute(@parent, 'Total_Intensity') AND distance($geometry, geometry(@parent)) &lt;= 50000&#xd;&#xa;       ) = 0&#xd;&#xa;  THEN 0&#xd;&#xa;  &#xd;&#xa;  -- 2. ADM PROXIMITY BLOCK: ADM points drop to Tier 1 if ANY Grid cell within 50km wants Tier 0&#xd;&#xa;  WHEN &quot;Point_Src&quot; = 'ADM' AND &quot;Target_Tier&quot; = 0 AND&#xd;&#xa;       aggregate(&#xd;&#xa;         layer:=@layer,&#xd;&#xa;         aggregate:='count',&#xd;&#xa;         expression:=&quot;ZONENO&quot;,&#xd;&#xa;         filter:=&quot;Point_Src&quot; = 'Grid' AND &quot;Target_Tier&quot; = 0 AND distance($geometry, geometry(@parent)) &lt;= 50000&#xd;&#xa;       ) > 0&#xd;&#xa;  THEN 1 -- Automatic downgrade to Tier 1&#xd;&#xa;  &#xd;&#xa;  -- 3. ADM WINNER: ADM point wins Tier 0 if no Grid cells compete within 50km&#xd;&#xa;  WHEN &quot;Point_Src&quot; = 'ADM' AND &quot;Target_Tier&quot; = 0&#xd;&#xa;  THEN 0&#xd;&#xa;  &#xd;&#xa;  ELSE &quot;TypeNo&quot;&#xd;&#xa;END"/>
          </Option>
        </Option>
        <Option name="INPUT" type="List">
          <Option type="Map">
            <Option name="child_id" type="QString" value="native:mergevectorlayers_5"/>
            <Option name="output_name" type="QString" value="OUTPUT"/>
            <Option name="source" type="int" value="1"/>
          </Option>
        </Option>
      </Option>
    </Option>
