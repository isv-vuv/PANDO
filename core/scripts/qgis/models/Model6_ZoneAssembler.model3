          <Option type="Map">
            <Option name="source" type="int" value="2"/>
            <Option name="static_value" type="QString" value="CASE&#xd;&#xa;  -- 1. GRID COMPETITION: Grid cells check for finalized Tier 0 blocks (50km) and stronger Tier 1 Grid cells (30km)&#xd;&#xa;  WHEN &quot;Point_Src&quot; = 'Grid' AND &quot;Target_Tier&quot; = 1 AND&#xd;&#xa;       aggregate(layer:=@layer, aggregate:='count', expression:=&quot;ZONENO&quot;, filter:=&quot;TypeNo&quot; = 0 AND distance($geometry, geometry(@parent)) &lt;= 50000) = 0 AND&#xd;&#xa;       aggregate(layer:=@layer, aggregate:='count', expression:=&quot;ZONENO&quot;, filter:=&quot;Point_Src&quot; = 'Grid' AND &quot;Target_Tier&quot; = 1 AND &quot;Total_Intensity&quot; > attribute(@parent, 'Total_Intensity') AND distance($geometry, geometry(@parent)) &lt;= 30000) = 0&#xd;&#xa;  THEN 1&#xd;&#xa;  &#xd;&#xa;  -- 2. ADM PROXIMITY BLOCK: ADM point drops to Tier 2 if a final Tier 0 is within 50km, ANY Grid cell wants Tier 1 within 30km, or it hits the 1.5km layout buffer&#xd;&#xa;  WHEN &quot;Point_Src&quot; = 'ADM' AND &quot;TypeNo&quot; = 1 AND&#xd;&#xa;       (&#xd;&#xa;         aggregate(layer:=@layer, aggregate:='count', expression:=&quot;ZONENO&quot;, filter:=&quot;TypeNo&quot; = 0 AND distance($geometry, geometry(@parent)) &lt;= 50000) > 0 OR&#xd;&#xa;         aggregate(layer:=@layer, aggregate:='count', expression:=&quot;ZONENO&quot;, filter:=&quot;Point_Src&quot; = 'Grid' AND &quot;Target_Tier&quot; = 1 AND distance($geometry, geometry(@parent)) &lt;= 30000) > 0 OR&#xd;&#xa;         aggregate(layer:=@layer, aggregate:='count', expression:=&quot;ZONENO&quot;, filter:=&quot;Point_Src&quot; = 'Grid' AND distance($geometry, geometry(@parent)) &lt;= 1500) > 0&#xd;&#xa;       )&#xd;&#xa;  THEN 2 -- Automatic downgrade to Tier 2&#xd;&#xa;  &#xd;&#xa;  -- 3. ADM WINNER: ADM point retains Tier 1 if all Grid blocks are cleared&#xd;&#xa;  WHEN &quot;Point_Src&quot; = 'ADM' AND &quot;TypeNo&quot; = 1&#xd;&#xa;  THEN 1&#xd;&#xa;  &#xd;&#xa;  ELSE &quot;TypeNo&quot;&#xd;&#xa;END"/>
          </Option>
        </Option>
        <Option name="INPUT" type="List">
          <Option type="Map">
            <Option name="child_id" type="QString" value="native:fieldcalculator_3"/>
            <Option name="output_name" type="QString" value="OUTPUT"/>
            <Option name="source" type="int" value="1"/>
          </Option>
        </Option>
      </Option>
    </Option>
    <Option name="native:fieldcalculator_5" type="Map">
      <Option name="active" type="bool" value="true"/>
      <Option name="alg_config"/>
      <Option name="alg_id" type="QString" value="native:fieldcalculator"/>
      <Option name="color" type="QString" value=""/>
      <Option name="comment" type="Map">
        <Option name="color" type="QString" value=""/>
        <Option name="component_description" type="QString" value=""/>
        <Option name="component_height" type="double" value="60"/>
        <Option name="component_pos_x" type="double" value="4049.375"/>
        <Option name="component_pos_y" type="double" value="3162.5"/>
        <Option name="component_width" type="double" value="100"/>
        <Option name="outputs_collapsed" type="bool" value="true"/>
        <Option name="parameters_collapsed" type="bool" value="true"/>
      </Option>
      <Option name="component_description" type="QString" value="Field calculator: TypeNo2"/>
      <Option name="component_height" type="double" value="30"/>
      <Option name="component_pos_x" type="double" value="580"/>
      <Option name="component_pos_y" type="double" value="1485"/>
      <Option name="component_width" type="double" value="200"/>
      <Option name="dependencies"/>
      <Option name="id" type="QString" value="native:fieldcalculator_5"/>
      <Option name="outputs"/>
      <Option name="outputs_collapsed" type="bool" value="true"/>
      <Option name="parameters_collapsed" type="bool" value="true"/>
      <Option name="params" type="Map">
        <Option name="FIELD_LENGTH" type="List">
          <Option type="Map">
            <Option name="source" type="int" value="2"/>
            <Option name="static_value" type="int" value="0"/>
          </Option>
        </Option>
        <Option name="FIELD_NAME" type="List">
          <Option type="Map">
            <Option name="source" type="int" value="2"/>
            <Option name="static_value" type="QString" value="TypeNo"/>
          </Option>
        </Option>
        <Option name="FIELD_PRECISION" type="List">
          <Option type="Map">
            <Option name="source" type="int" value="2"/>
            <Option name="static_value" type="int" value="0"/>
          </Option>
        </Option>
        <Option name="FIELD_TYPE" type="List">
          <Option type="Map">
            <Option name="source" type="int" value="2"/>
            <Option name="static_value" type="int" value="1"/>
          </Option>
        </Option>
        <Option name="FORMULA" type="List">
          <Option type="Map">
            <Option name="source" type="int" value="2"/>
            <Option name="static_value" type="QString" value="CASE&#xd;&#xa;  -- 1. GRID COMPETITION: Grid cells check for Tier 1 blocks (30km) and stronger Tier 2 competitors (10km)&#xd;&#xa;  WHEN &quot;Point_Src&quot; = 'Grid' AND (&quot;Target_Tier&quot; = 2 OR (&quot;Target_Tier&quot; = 1 AND &quot;TypeNo&quot; > 1)) AND&#xd;&#xa;       aggregate(layer:=@layer, aggregate:='count', expression:=&quot;ZONENO&quot;, filter:=&quot;TypeNo&quot; = 1 AND distance($geometry, geometry(@parent)) &lt;= 30000) = 0 AND&#xd;&#xa;       aggregate(layer:=@layer, aggregate:='count', expression:=&quot;ZONENO&quot;, filter:=&quot;Point_Src&quot; = 'Grid' AND &quot;Target_Tier&quot; IN (1, 2) AND &quot;Total_Intensity&quot; > attribute(@parent, 'Total_Intensity') AND distance($geometry, geometry(@parent)) &lt;= 10000) = 0&#xd;&#xa;  THEN 2&#xd;&#xa;  &#xd;&#xa;  -- 2. ADM PROXIMITY BLOCK: ADM point drops to Tier 3 if a final Tier 1 is within 30km, ANY Grid cell wants Tier 1/2 within 10km, or it hits the 1.5km layout buffer&#xd;&#xa;  WHEN &quot;Point_Src&quot; = 'ADM' AND &quot;TypeNo&quot; = 2 AND&#xd;&#xa;       (&#xd;&#xa;         aggregate(layer:=@layer, aggregate:='count', expression:=&quot;ZONENO&quot;, filter:=&quot;TypeNo&quot; = 1 AND distance($geometry, geometry(@parent)) &lt;= 30000) > 0 OR&#xd;&#xa;         aggregate(layer:=@layer, aggregate:='count', expression:=&quot;ZONENO&quot;, filter:=&quot;Point_Src&quot; = 'Grid' AND &quot;Target_Tier&quot; IN (1, 2) AND distance($geometry, geometry(@parent)) &lt;= 10000) > 0 OR&#xd;&#xa;         aggregate(layer:=@layer, aggregate:='count', expression:=&quot;ZONENO&quot;, filter:=&quot;Point_Src&quot; = 'Grid' AND distance($geometry, geometry(@parent)) &lt;= 1500) > 0&#xd;&#xa;       )&#xd;&#xa;  THEN 3 -- Automatic downgrade to Tier 3&#xd;&#xa;  &#xd;&#xa;  -- 3. ADM WINNER: ADM point retains Tier 2 if all Grid blocks are cleared&#xd;&#xa;  WHEN &quot;Point_Src&quot; = 'ADM' AND &quot;TypeNo&quot; = 2&#xd;&#xa;  THEN 2&#xd;&#xa;  &#xd;&#xa;  ELSE &quot;TypeNo&quot;&#xd;&#xa;END"/>
          </Option>
        </Option>
        <Option name="INPUT" type="List">
          <Option type="Map">
            <Option name="child_id" type="QString" value="native:fieldcalculator_4"/>
            <Option name="output_name" type="QString" value="OUTPUT"/>
            <Option name="source" type="int" value="1"/>
          </Option>
        </Option>
      </Option>
    </Option>
    <Option name="native:fieldcalculator_6" type="Map">
      <Option name="active" type="bool" value="true"/>
      <Option name="alg_config"/>
      <Option name="alg_id" type="QString" value="native:fieldcalculator"/>
      <Option name="color" type="QString" value=""/>
      <Option name="comment" type="Map">
        <Option name="color" type="QString" value=""/>
        <Option name="component_description" type="QString" value=""/>
        <Option name="component_height" type="double" value="60"/>
        <Option name="component_pos_x" type="double" value="3783.125"/>
        <Option name="component_pos_y" type="double" value="2905.625"/>
        <Option name="component_width" type="double" value="100"/>
        <Option name="outputs_collapsed" type="bool" value="true"/>
        <Option name="parameters_collapsed" type="bool" value="true"/>
      </Option>
      <Option name="component_description" type="QString" value="Field calculator: TypeNo3"/>
      <Option name="component_height" type="double" value="30"/>
      <Option name="component_pos_x" type="double" value="580"/>
      <Option name="component_pos_y" type="double" value="1545"/>
      <Option name="component_width" type="double" value="200"/>
      <Option name="dependencies"/>
      <Option name="id" type="QString" value="native:fieldcalculator_6"/>
      <Option name="outputs"/>
      <Option name="outputs_collapsed" type="bool" value="true"/>
      <Option name="parameters_collapsed" type="bool" value="true"/>
      <Option name="params" type="Map">
        <Option name="FIELD_LENGTH" type="List">
          <Option type="Map">
            <Option name="source" type="int" value="2"/>
            <Option name="static_value" type="int" value="0"/>
          </Option>
        </Option>
        <Option name="FIELD_NAME" type="List">
          <Option type="Map">
            <Option name="source" type="int" value="2"/>
            <Option name="static_value" type="QString" value="TypeNo"/>
          </Option>
        </Option>
        <Option name="FIELD_PRECISION" type="List">
          <Option type="Map">
            <Option name="source" type="int" value="2"/>
            <Option name="static_value" type="int" value="0"/>
          </Option>
        </Option>
        <Option name="FIELD_TYPE" type="List">
          <Option type="Map">
            <Option name="source" type="int" value="2"/>
            <Option name="static_value" type="int" value="1"/>
          </Option>
        </Option>
        <Option name="FORMULA" type="List">
          <Option type="Map">
            <Option name="source" type="int" value="2"/>
            <Option name="static_value" type="QString" value="CASE&#xd;&#xa;  -- 1. GRID WINNER: Becomes Tier 3 if it passes all spatial filters AND is the absolute intensity king within its NO_E0 zone&#xd;&#xa;  WHEN &quot;Point_Src&quot; = 'Grid' AND (&quot;Target_Tier&quot; = 3 OR (&quot;Target_Tier&quot; IN (1, 2) AND &quot;TypeNo&quot; > 2)) AND&#xd;&#xa;       -- Spatial blocks (10km from Tier 2, 2km from stronger Tier 3 Grid cells)&#xd;&#xa;       aggregate(layer:=@layer, aggregate:='count', expression:=&quot;ZONENO&quot;, filter:=&quot;TypeNo&quot; = 2 AND distance($geometry, geometry(@parent)) &lt;= 10000) = 0 AND&#xd;&#xa;       aggregate(layer:=@layer, aggregate:='count', expression:=&quot;ZONENO&quot;, filter:=&quot;Point_Src&quot; = 'Grid' AND &quot;Target_Tier&quot; IN (1, 2, 3) AND &quot;Total_Intensity&quot; > attribute(@parent, 'Total_Intensity') AND distance($geometry, geometry(@parent)) &lt;= 2000) = 0 AND&#xd;&#xa;       -- NEW NO_E0 INTRA-ZONE COMPETITION: Blocked if another cell in the same NO_E0 already achieved Tier 0, 1, or 2&#xd;&#xa;       aggregate(layer:=@layer, aggregate:='count', expression:=&quot;ZONENO&quot;, filter:=&quot;NO_E0&quot; = attribute(@parent, 'NO_E0') AND &quot;TypeNo&quot; IN (0, 1, 2)) = 0 AND&#xd;&#xa;       -- NEW NO_E0 INTRA-ZONE COMPETITION: Blocked if another Grid cell in the same NO_E0 has a higher intensity&#xd;&#xa;       aggregate(layer:=@layer, aggregate:='count', expression:=&quot;ZONENO&quot;, filter:=&quot;Point_Src&quot; = 'Grid' AND &quot;NO_E0&quot; = attribute(@parent, 'NO_E0') AND &quot;Total_Intensity&quot; > attribute(@parent, 'Total_Intensity') AND (&quot;Target_Tier&quot; = 3 OR (&quot;Target_Tier&quot; IN (1, 2) AND &quot;TypeNo&quot; > 2))) = 0&#xd;&#xa;  THEN 3&#xd;&#xa;&#xd;&#xa;  -- 2. GRID LOSER: If a Grid cell wanted to be Tier 3 but lost the internal NO_E0 intensity competition, it is demoted to Tier 4&#xd;&#xa;  WHEN &quot;Point_Src&quot; = 'Grid' AND (&quot;Target_Tier&quot; = 3 OR (&quot;Target_Tier&quot; IN (1, 2) AND &quot;TypeNo&quot; > 2))&#xd;&#xa;  THEN 4&#xd;&#xa;&#xd;&#xa;  -- 3. ADM PROXIMITY &amp; NO_E0 BLOCK: ADM point drops to Tier 4 if blocked by proximity OR if ANY valid Grid center exists in the same NO_E0 zone&#xd;&#xa;  WHEN &quot;Point_Src&quot; = 'ADM' AND &quot;TypeNo&quot; = 3 AND&#xd;&#xa;       (&#xd;&#xa;         -- Proximity blocks (10km Tier 2, 2km Grid Tier 3, 1.5km Grid buffer)&#xd;&#xa;         aggregate(layer:=@layer, aggregate:='count', expression:=&quot;ZONENO&quot;, filter:=&quot;TypeNo&quot; = 2 AND distance($geometry, geometry(@parent)) &lt;= 10000) > 0 OR&#xd;&#xa;         aggregate(layer:=@layer, aggregate:='count', expression:=&quot;ZONENO&quot;, filter:=&quot;Point_Src&quot; = 'Grid' AND &quot;Target_Tier&quot; IN (1, 2, 3) AND distance($geometry, geometry(@parent)) &lt;= 2000) > 0 OR&#xd;&#xa;         aggregate(layer:=@layer, aggregate:='count', expression:=&quot;ZONENO&quot;, filter:=&quot;Point_Src&quot; = 'Grid' AND distance($geometry, geometry(@parent)) &lt;= 1500) > 0 OR&#xd;&#xa;         -- ABSOLUTE GRID PRIORITY: Blocked if ANY Grid point in the same NO_E0 zone is Tier 3 or better (either already finalized or currently winning)&#xd;&#xa;         aggregate(layer:=@layer, aggregate:='count', expression:=&quot;ZONENO&quot;, filter:=&quot;Point_Src&quot; = 'Grid' AND &quot;NO_E0&quot; = attribute(@parent, 'NO_E0') AND (&quot;TypeNo&quot; IN (0, 1, 2) OR &quot;Target_Tier&quot; = 3 OR (&quot;Target_Tier&quot; IN (1, 2) AND &quot;TypeNo&quot; > 2))) > 0&#xd;&#xa;       )&#xd;&#xa;  THEN 4 -- Demoted to Tier 4&#xd;&#xa;&#xd;&#xa;  -- 4. ADM WINNER: ADM point retains Tier 3 if the entire NO_E0 zone is completely clear of any urban Grid centers&#xd;&#xa;  WHEN &quot;Point_Src&quot; = 'ADM' AND &quot;TypeNo&quot; = 3&#xd;&#xa;  THEN 3&#xd;&#xa;&#xd;&#xa;  ELSE &quot;TypeNo&quot;&#xd;&#xa;END"/>
          </Option>
        </Option>
        <Option name="INPUT" type="List">
          <Option type="Map">
            <Option name="child_id" type="QString" value="native:fieldcalculator_5"/>
            <Option name="output_name" type="QString" value="OUTPUT"/>
            <Option name="source" type="int" value="1"/>
          </Option>
        </Option>
      </Option>
    </Option>
