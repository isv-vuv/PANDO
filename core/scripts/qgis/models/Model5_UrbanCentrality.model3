          <Option type="Map">
            <Option name="source" type="int" value="2"/>
            <Option name="static_value" type="QString" value="CASE&#xd;&#xa;    -- 1. Governance, Public Services &amp; Banking&#xd;&#xa;    WHEN &quot;amenity&quot; IN ('courthouse', 'townhall', 'bank', 'post_office') &#xd;&#xa;         OR &quot;office&quot; IN ('government', 'employment_agency') &#xd;&#xa;         THEN 'GOVERNMENT'&#xd;&#xa;&#xd;&#xa;    -- 2. Education&#xd;&#xa;    WHEN &quot;amenity&quot; IN ('university', 'college', 'school', 'kindergarten') &#xd;&#xa;         THEN 'EDUCATION'&#xd;&#xa;&#xd;&#xa;    -- 3. Retail &amp; Daily Supplies&#xd;&#xa;    WHEN &quot;shop&quot; IN ('mall', 'department_store', 'chemist', 'general', 'beverages', 'supermarket', 'bakery', 'butcher', 'convenience', 'kiosk') &#xd;&#xa;         OR &quot;amenity&quot; = 'marketplace' &#xd;&#xa;         THEN 'RETAIL'&#xd;&#xa;&#xd;&#xa;    -- 4. Leisure, Culture &amp; Tourism&#xd;&#xa;    WHEN &quot;tourism&quot; IN ('aquarium', 'gallery', 'museum', 'theme_park', 'zoo') &#xd;&#xa;         OR &quot;leisure&quot; IN ('stadium', 'water_park', 'sports_centre', 'sports_hall')&#xd;&#xa;         OR &quot;amenity&quot; IN ('conference_centre', 'concert_hall', 'exhibition_centre', 'theatre', 'planetarium', 'events_venue', 'library', 'cinema', 'music_school', 'public_bath', 'community_centre', 'place_of_worship') &#xd;&#xa;         THEN 'LEISURE'&#xd;&#xa;&#xd;&#xa;    -- 5. Healthcare &amp; Social Infrastructure&#xd;&#xa;    WHEN &quot;amenity&quot; IN ('clinic', 'hospital', 'pharmacy', 'doctors', 'dentist', 'social_facility', 'nursing_home', 'youth_centre', 'social_centre') &#xd;&#xa;         OR &quot;healthcare&quot; IN ('clinic', 'hospital', 'pharmacy', 'doctor', 'dentist', 'centre') &#xd;&#xa;         THEN 'HEALTHCARE'&#xd;&#xa;&#xd;&#xa;    ELSE 'OTHER'&#xd;&#xa;END"/>
          </Option>
        </Option>
        <Option name="INPUT" type="List">
          <Option type="Map">
            <Option name="child_id" type="QString" value="native:extractbyexpression_6"/>
            <Option name="output_name" type="QString" value="OUTPUT"/>
            <Option name="source" type="int" value="1"/>
          </Option>
        </Option>
      </Option>
    </Option>
    <Option name="native:fieldcalculator_15" type="Map">
      <Option name="active" type="bool" value="true"/>
      <Option name="alg_config"/>
      <Option name="alg_id" type="QString" value="native:fieldcalculator"/>
      <Option name="color" type="QString" value=""/>
      <Option name="comment" type="Map">
        <Option name="color" type="QString" value=""/>
        <Option name="component_description" type="QString" value=""/>
        <Option name="component_height" type="double" value="60"/>
        <Option name="component_pos_x" type="double" value="4011"/>
        <Option name="component_pos_y" type="double" value="3928"/>
        <Option name="component_width" type="double" value="100"/>
        <Option name="outputs_collapsed" type="bool" value="true"/>
        <Option name="parameters_collapsed" type="bool" value="true"/>
      </Option>
      <Option name="component_description" type="QString" value="Field calculator: classification (polygons)"/>
      <Option name="component_height" type="double" value="30"/>
      <Option name="component_pos_x" type="double" value="240"/>
      <Option name="component_pos_y" type="double" value="375"/>
      <Option name="component_width" type="double" value="180"/>
      <Option name="dependencies"/>
      <Option name="id" type="QString" value="native:fieldcalculator_15"/>
      <Option name="outputs"/>
      <Option name="outputs_collapsed" type="bool" value="true"/>
      <Option name="parameters_collapsed" type="bool" value="true"/>
      <Option name="params" type="Map">
        <Option name="FIELD_LENGTH" type="List">
          <Option type="Map">
            <Option name="source" type="int" value="2"/>
            <Option name="static_value" type="int" value="0"/>
          </Option>
        </Option>
        <Option name="FIELD_NAME" type="List">
          <Option type="Map">
            <Option name="source" type="int" value="2"/>
            <Option name="static_value" type="QString" value="classification"/>
          </Option>
        </Option>
        <Option name="FIELD_PRECISION" type="List">
          <Option type="Map">
            <Option name="source" type="int" value="2"/>
            <Option name="static_value" type="int" value="0"/>
          </Option>
        </Option>
        <Option name="FIELD_TYPE" type="List">
          <Option type="Map">
            <Option name="source" type="int" value="2"/>
            <Option name="static_value" type="int" value="2"/>
          </Option>
        </Option>
        <Option name="FORMULA" type="List">
          <Option type="Map">
            <Option name="source" type="int" value="2"/>
            <Option name="static_value" type="QString" value="with_variable(&#xd;&#xa;    'search_string',&#xd;&#xa;    lower(&#xd;&#xa;        coalesce(&quot;name&quot;, '') || ' ' || coalesce(&quot;name:en&quot;, '') || ' ' || coalesce(&quot;name:de&quot;, '') || ' ' ||&#xd;&#xa;        coalesce(&quot;name:es&quot;, '') || ' ' || coalesce(&quot;name:fr&quot;, '') || ' ' || coalesce(&quot;name:pt&quot;, '') || ' ' ||&#xd;&#xa;        coalesce(&quot;name:ru&quot;, '') || ' ' || coalesce(&quot;name:ar&quot;, '') || ' ' || coalesce(&quot;name:zh&quot;, '') || ' ' ||&#xd;&#xa;        coalesce(&quot;name:ja&quot;, '') || ' ' || coalesce(&quot;name:hi&quot;, '') || ' ' || coalesce(&quot;alt_name&quot;, '') || ' ' ||&#xd;&#xa;        coalesce(&quot;official_name&quot;, '')&#xd;&#xa;    ),&#xd;&#xa;    CASE &#xd;&#xa;        -----------------------------------------------------------------&#xd;&#xa;        -- SECTOR: EDUCATION (Tiers F, E, D)&#xd;&#xa;        -----------------------------------------------------------------&#xd;&#xa;        WHEN &quot;sector&quot; = 'EDUCATION' THEN&#xd;&#xa;            CASE&#xd;&#xa;                -- Stage F: Further Education&#xd;&#xa;                WHEN regexp_match(&quot;isced:level&quot;, '.*[5-8].*') > 0 OR &quot;amenity&quot; IN ('university', 'college', 'research_institute') OR regexp_match(@search_string, '(universit|hochschule|akademie|fakult|college|academy|faculty|polytechnic|seminary)') > 0 THEN 'F'&#xd;&#xa;                -- Stage D: Developmental / Primary / Pre-School&#xd;&#xa;                WHEN regexp_match(&quot;isced:level&quot;, '^[01;-]+$') > 0 OR &quot;amenity&quot; = 'kindergarten' OR regexp_match(@search_string, '(grundschule|primarschule|kindergarten|kita|vorschule|primary|elementary|nursery|maternelle|preescolar)') > 0 THEN 'D'&#xd;&#xa;                -- Stage E: Essential / Secondary Schools (plus fallback)&#xd;&#xa;                WHEN regexp_match(&quot;isced:level&quot;, '.*[2-4].*') > 0 OR &quot;amenity&quot; = 'school' OR regexp_match(@search_string, '(gymnasium|realschule|hauptschule|sekundar|beruf|high school|secondary|vocational|collège|lycée|colegio)') > 0 THEN 'E'&#xd;&#xa;                ELSE 'E'&#xd;&#xa;            END&#xd;&#xa;&#xd;&#xa;        -----------------------------------------------------------------&#xd;&#xa;        -- SECTOR: GOVERNMENT (Tiers C, B, A)&#xd;&#xa;        -----------------------------------------------------------------&#xd;&#xa;        WHEN &quot;sector&quot; = 'GOVERNMENT' THEN&#xd;&#xa;            CASE&#xd;&#xa;                -- Stage C: Courthouse / Central Judiciary&#xd;&#xa;                WHEN &quot;amenity&quot; = 'courthouse' OR regexp_match(@search_string, '(gericht|justiz|court|tribunal|juzgado|суд)') > 0 THEN 'C'&#xd;&#xa;                -- Stage B: Bureau / Civic Services&#xd;&#xa;                WHEN &quot;amenity&quot; = 'social_facility' OR &quot;office&quot; IN ('government', 'employment_agency', 'lawyer', 'notary') OR regexp_match(@search_string, '(amt|behörde|bureau|administration|администрация)') > 0 THEN 'B'&#xd;&#xa;                -- Stage A: Agency / Daily Base Operations&#xd;&#xa;                WHEN &quot;amenity&quot; IN ('bank', 'post_office', 'townhall') OR regexp_match(@search_string, '(bank|post|rathaus|town hall|city hall|mairie|мэрия)') > 0 THEN 'A'&#xd;&#xa;                ELSE 'A'&#xd;&#xa;            END&#xd;&#xa;&#xd;&#xa;        -----------------------------------------------------------------&#xd;&#xa;        -- SECTOR: HEALTHCARE (Tiers O, N, M)&#xd;&#xa;        -----------------------------------------------------------------&#xd;&#xa;        WHEN &quot;sector&quot; = 'HEALTHCARE' THEN&#xd;&#xa;            CASE&#xd;&#xa;                -- Stage O: Hospitals (Operation Centers)&#xd;&#xa;                WHEN &quot;amenity&quot; = 'hospital' OR &quot;healthcare&quot; IN ('hospital', 'hospice', 'rehabilitation') OR regexp_match(@search_string, '(krankenhaus|klinikum|spital|hospital|hôpital|больница|医院|病院)') > 0 THEN 'O'&#xd;&#xa;                -- Stage M: Pharmacies / Chemist (Medicine Supply)&#xd;&#xa;                WHEN &quot;amenity&quot; = 'pharmacy' OR &quot;healthcare&quot; = 'pharmacy' OR &quot;shop&quot; IN ('chemist', 'drugstore') OR regexp_match(@search_string, '(apotheke|pharmacy|chemist|drugstore|pharmacie|farmacia|аптека|药店|薬局)') > 0 THEN 'M'&#xd;&#xa;                -- Stage N: Doctors / Clinics / Normal Care &amp; Fallback&#xd;&#xa;                ELSE 'N'&#xd;&#xa;            END&#xd;&#xa;&#xd;&#xa;        -----------------------------------------------------------------&#xd;&#xa;        -- SECTOR: LEISURE &amp; CULTURE (Tiers L, K, J)&#xd;&#xa;        -----------------------------------------------------------------&#xd;&#xa;        WHEN &quot;sector&quot; = 'LEISURE' THEN&#xd;&#xa;            CASE&#xd;&#xa;                -- Stage L: Regional Landmarks &amp; Large Destinations&#xd;&#xa;                WHEN &quot;leisure&quot; IN ('stadium', 'water_park') OR &quot;tourism&quot; IN ('theme_park', 'zoo', 'aquarium', 'attraction') OR &quot;amenity&quot; IN ('conference_centre', 'exhibition_centre', 'events_venue') OR regexp_match(@search_string, '(stadion|stadium|zoo|freizeitpark|theme park|messe|exhibition|parc d''attraction)') > 0 THEN 'L'&#xd;&#xa;                -- Stage K: Urban Knots / City-level Venues&#xd;&#xa;                WHEN &quot;leisure&quot; IN ('sports_centre', 'sports_hall') OR &quot;amenity&quot; IN ('cinema', 'theatre', 'public_bath', 'arts_centre', 'concert_hall', 'planetarium', 'music_school') OR &quot;tourism&quot; = 'museum' OR regexp_match(@search_string, '(kino|cinema|theater|theatre|museum|musée|sporthalle|sports centre|体育中心)') > 0 THEN 'K'&#xd;&#xa;                -- Stage J: Neighborhood Assets / Neighborhood Leisure&#xd;&#xa;                WHEN &quot;leisure&quot; = 'pitch' OR &quot;amenity&quot; IN ('library', 'community_centre', 'youth_centre', 'place_of_worship', 'social_centre') OR &quot;tourism&quot; = 'gallery' OR regexp_match(@search_string, '(bibliothek|bücherei|library|gemeindezentrum|community centre|kirche|church|églis|moschee|mosque)') > 0 THEN 'J'&#xd;&#xa;                ELSE 'J'&#xd;&#xa;            END&#xd;&#xa;&#xd;&#xa;        -----------------------------------------------------------------&#xd;&#xa;        -- SECTOR: RETAIL (Tiers T, S, R)&#xd;&#xa;        -----------------------------------------------------------------&#xd;&#xa;        WHEN &quot;sector&quot; = 'RETAIL' THEN&#xd;&#xa;            CASE&#xd;&#xa;                -- Stage T: Destination Shopping / Top Tier Malls&#xd;&#xa;                WHEN &quot;shop&quot; IN ('mall', 'department_store') OR regexp_match(@search_string, '(einkaufszentrum|kaufhaus|shopping cent|department store|mall|commercial|торговый центр)') > 0 THEN 'T'&#xd;&#xa;                -- Stage S: Specialized / Specific Retail&#xd;&#xa;                WHEN &quot;shop&quot; IN ('clothes', 'electronics', 'furniture', 'doityourself', 'books', 'shoes', 'sports', 'general') OR regexp_match(@search_string, '(baumarkt|möbelhaus|fachmarkt|diy|bricolage|furniture|electronics|fashion|одежда)') > 0 THEN 'S'&#xd;&#xa;                -- Stage R: Regular / Daily Grocery Needs&#xd;&#xa;                WHEN &quot;shop&quot; IN ('supermarket', 'discounter', 'convenience', 'bakery', 'butcher', 'kiosk', 'beverages', 'chemist', 'drugstore') OR &quot;amenity&quot; = 'marketplace' OR regexp_match(@search_string, '(supermarkt|supermarket|bäckerei|bakery|boulanger|grocery|metzgerei|butcher|markt|market)') > 0 THEN 'R'&#xd;&#xa;                ELSE 'R'&#xd;&#xa;            END&#xd;&#xa;&#xd;&#xa;        ELSE NULL&#xd;&#xa;    END&#xd;&#xa;)"/>
          </Option>
        </Option>
        <Option name="INPUT" type="List">
          <Option type="Map">
            <Option name="child_id" type="QString" value="native:fieldcalculator_1"/>
            <Option name="output_name" type="QString" value="OUTPUT"/>
            <Option name="source" type="int" value="1"/>
          </Option>
        </Option>
      </Option>
    </Option>
