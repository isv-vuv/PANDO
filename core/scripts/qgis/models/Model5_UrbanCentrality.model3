            <Option name="static_value" type="QString" value="CASE&#xd;&#xa;  WHEN &quot;amenity&quot; = 'courthouse' THEN 'Court of law for legal proceedings'&#xd;&#xa;  WHEN &quot;office&quot; = 'government' THEN 'Government office or public administration'&#xd;&#xa;  WHEN &quot;office&quot; = 'employment_agency' THEN 'Employment or job center'&#xd;&#xa;  WHEN &quot;office&quot; = 'lawyer' THEN 'Lawyer or legal office'&#xd;&#xa;  WHEN &quot;amenity&quot; = 'bank' THEN 'Bank or financial institution'&#xd;&#xa;  WHEN &quot;office&quot; = 'notary' THEN 'Notary public office'&#xd;&#xa;  WHEN &quot;amenity&quot; = 'post_office' THEN 'Post office for mail services'&#xd;&#xa;  WHEN &quot;amenity&quot; = 'townhall' THEN 'Town hall or city administration'&#xd;&#xa;  WHEN &quot;amenity&quot; = 'social_facility' THEN 'Social or care facility'&#xd;&#xa;  WHEN &quot;amenity&quot; = 'university' THEN 'University or higher education'&#xd;&#xa;  WHEN &quot;amenity&quot; = 'college' THEN 'College or vocational school'&#xd;&#xa;  WHEN &quot;amenity&quot; = 'kindergarten' THEN 'Kindergarten or preschool'&#xd;&#xa;  WHEN &quot;amenity&quot; = 'school' THEN 'Primary or secondary school'&#xd;&#xa;  WHEN &quot;shop&quot; = 'mall' THEN 'Shopping mall with many stores'&#xd;&#xa;  WHEN &quot;shop&quot; = 'department_store' THEN 'Large department store'&#xd;&#xa;  WHEN &quot;amenity&quot; = 'marketplace' THEN 'Marketplace or weekly market'&#xd;&#xa;  WHEN &quot;shop&quot; = 'chemist' THEN 'Chemist or drugstore'&#xd;&#xa;  WHEN &quot;shop&quot; = 'general' THEN 'General or mixed goods store'&#xd;&#xa;  WHEN &quot;shop&quot; = 'beverages' THEN 'Beverage or drinks shop'&#xd;&#xa;  WHEN &quot;shop&quot; = 'supermarket' THEN 'Supermarket for groceries'&#xd;&#xa;  WHEN &quot;shop&quot; = 'bakery' THEN 'Bakery for bread and pastries'&#xd;&#xa;  WHEN &quot;shop&quot; = 'butcher' THEN 'Butcher shop for meat'&#xd;&#xa;  WHEN &quot;shop&quot; = 'convenience' THEN 'Convenience store for daily needs'&#xd;&#xa;  WHEN &quot;shop&quot; = 'kiosk' THEN 'Kiosk or small booth'&#xd;&#xa;  WHEN &quot;tourism&quot; = 'aquarium' THEN 'Aquarium for aquatic life'&#xd;&#xa;  WHEN &quot;amenity&quot; = 'conference_centre' THEN 'Conference or convention center'&#xd;&#xa;  WHEN &quot;amenity&quot; = 'concert_hall' THEN 'Concert hall for live music'&#xd;&#xa;  WHEN &quot;amenity&quot; = 'arts_centre' THEN 'Arts or cultural center'&#xd;&#xa;  WHEN &quot;tourism&quot; = 'gallery' THEN 'Art gallery for exhibitions'&#xd;&#xa;  WHEN &quot;amenity&quot; = 'exhibition_centre' THEN 'Exhibition or trade fair center'&#xd;&#xa;  WHEN &quot;tourism&quot; = 'museum' THEN 'Museum for history or art'&#xd;&#xa;  WHEN &quot;amenity&quot; = 'theatre' THEN 'Theatre or opera house'&#xd;&#xa;  WHEN &quot;amenity&quot; = 'planetarium' THEN 'Planetarium for astronomy shows'&#xd;&#xa;  WHEN &quot;tourism&quot; = 'attraction' THEN 'Tourist attraction or landmark'&#xd;&#xa;  WHEN &quot;leisure&quot; = 'stadium' THEN 'Stadium for sports and events'&#xd;&#xa;  WHEN &quot;tourism&quot; = 'theme_park' THEN 'Theme park or amusement park'&#xd;&#xa;  WHEN &quot;amenity&quot; = 'events_venue' THEN 'Events or performance venue'&#xd;&#xa;  WHEN &quot;tourism&quot; = 'zoo' THEN 'Zoo for animals'&#xd;&#xa;  WHEN &quot;amenity&quot; = 'library' THEN 'Library for books and study'&#xd;&#xa;  WHEN &quot;leisure&quot; = 'water_park' THEN 'Water park or outdoor pool'&#xd;&#xa;  WHEN &quot;amenity&quot; = 'cinema' THEN 'Cinema or movie theater'&#xd;&#xa;  WHEN &quot;amenity&quot; = 'music_school' THEN 'Music school for lessons'&#xd;&#xa;  WHEN &quot;leisure&quot; = 'sports_centre' THEN 'Sports center or gym'&#xd;&#xa;  WHEN &quot;amenity&quot; = 'public_bath' THEN 'Public bath or spa'&#xd;&#xa;  WHEN &quot;amenity&quot; = 'community_centre' THEN 'Community or activity center'&#xd;&#xa;  WHEN &quot;amenity&quot; = 'youth_centre' THEN 'Youth or children’s center'&#xd;&#xa;  WHEN &quot;amenity&quot; = 'place_of_worship' THEN 'Religious building or church'&#xd;&#xa;  WHEN &quot;leisure&quot; = 'sports_hall' THEN 'Indoor sports hall'&#xd;&#xa;  WHEN &quot;leisure&quot; = 'pitch' THEN 'Sports pitch or field'&#xd;&#xa;  WHEN &quot;amenity&quot; = 'social_centre' THEN 'Social meeting center'&#xd;&#xa;  WHEN &quot;amenity&quot; = 'clinic' THEN 'Clinic for outpatient care'&#xd;&#xa;  WHEN &quot;healthcare&quot; = 'clinic' THEN 'Clinic for outpatient care'&#xd;&#xa;  WHEN &quot;amenity&quot; = 'hospital' THEN 'Hospital for medical care'&#xd;&#xa;  WHEN &quot;healthcare&quot; = 'hospital' THEN 'Hospital for medical care'&#xd;&#xa;  WHEN &quot;amenity&quot; = 'pharmacy' THEN 'Pharmacy for medicine'&#xd;&#xa;  WHEN &quot;healthcare&quot; = 'pharmacy' THEN 'Pharmacy for medicine'&#xd;&#xa;  WHEN &quot;amenity&quot; = 'doctors' THEN 'Doctors’ office or practice'&#xd;&#xa;  WHEN &quot;healthcare&quot; = 'doctor' THEN 'Doctors’ office or practice'&#xd;&#xa;  WHEN &quot;amenity&quot; = 'dentist' THEN 'Dentist office'&#xd;&#xa;  WHEN &quot;healthcare&quot; = 'dentist' THEN 'Dentist office'&#xd;&#xa;  WHEN &quot;healthcare&quot; = 'centre' THEN 'Medical center'&#xd;&#xa;  ELSE 'Other'&#xd;&#xa;END&#xd;&#xa;"/>
          </Option>
