      <Option name="component_description" type="QString" value="Field calculator: is_duplicate"/>
      <Option name="component_height" type="double" value="30"/>
      <Option name="component_pos_x" type="double" value="360"/>
      <Option name="component_pos_y" type="double" value="1125"/>
      <Option name="component_width" type="double" value="180"/>
      <Option name="dependencies"/>
      <Option name="id" type="QString" value="native:fieldcalculator_19"/>
      <Option name="outputs"/>
      <Option name="outputs_collapsed" type="bool" value="true"/>
      <Option name="parameters_collapsed" type="bool" value="true"/>
      <Option name="params" type="Map">
        <Option name="FIELD_LENGTH" type="List">
          <Option type="Map">
            <Option name="source" type="int" value="2"/>
            <Option name="static_value" type="int" value="0"/>
          </Option>
        </Option>
        <Option name="FIELD_NAME" type="List">
          <Option type="Map">
            <Option name="source" type="int" value="2"/>
            <Option name="static_value" type="QString" value="is_duplicate"/>
          </Option>
        </Option>
        <Option name="FIELD_PRECISION" type="List">
          <Option type="Map">
            <Option name="source" type="int" value="2"/>
            <Option name="static_value" type="int" value="0"/>
          </Option>
        </Option>
        <Option name="FIELD_TYPE" type="List">
          <Option type="Map">
            <Option name="source" type="int" value="2"/>
            <Option name="static_value" type="int" value="1"/>
          </Option>
        </Option>
        <Option name="FORMULA" type="List">
          <Option type="Map">
            <Option name="source" type="int" value="2"/>
            <Option name="static_value" type="QString" value="CASE&#xd;&#xa;    WHEN&#xd;&#xa;        -- 1. Ignore the self-intersection of the point&#xd;&#xa;        &quot;osm_id&quot; != &quot;joined_osm_id&quot; AND&#xd;&#xa;        &#xd;&#xa;        -- 2. Must be within the same functional sector (e.g. both RETAIL)&#xd;&#xa;        &quot;sector&quot; = &quot;joined_sector&quot; AND&#xd;&#xa;        &#xd;&#xa;        -- 3. FIX FOR BUTCHER/BAKER: Evaluates the specific OSM type directly without an extra column!&#xd;&#xa;        coalesce(&quot;shop&quot;, &quot;amenity&quot;, &quot;leisure&quot;, &quot;tourism&quot;, &quot;office&quot;, &quot;healthcare&quot;, 'unknown') = &#xd;&#xa;        coalesce(&quot;joined_shop&quot;, &quot;joined_amenity&quot;, &quot;joined_leisure&quot;, &quot;joined_tourism&quot;, &quot;joined_office&quot;, &quot;joined_healthcare&quot;, 'unknown') AND&#xd;&#xa;        &#xd;&#xa;        -- 4. Base names must exist&#xd;&#xa;        &quot;name_base&quot; IS NOT NULL AND &quot;joined_name_base&quot; IS NOT NULL AND &#xd;&#xa;        &quot;name_base&quot; != '' AND &quot;joined_name_base&quot; != '' AND&#xd;&#xa;        &#xd;&#xa;        -- 5. SMART NAME SIMILARITY (Jetzt absolut crash-proof über CASE WHEN)&#xd;&#xa;        CASE &#xd;&#xa;            WHEN length(&quot;name_base&quot;) &lt;= 5 OR length(&quot;joined_name_base&quot;) &lt;= 5&#xd;&#xa;            THEN &quot;name_base&quot; = &quot;joined_name_base&quot;&#xd;&#xa;            ELSE levenshtein(coalesce(&quot;name_base&quot;, ''), coalesce(&quot;joined_name_base&quot;, '')) &lt; 3&#xd;&#xa;        END AND&#xd;&#xa;        &#xd;&#xa;        -- 6. HIERARCHICAL TIE-BREAKER RULE&#xd;&#xa;        (&#xd;&#xa;            &quot;joined_classification&quot; > &quot;classification&quot; OR&#xd;&#xa;            (&#xd;&#xa;                &quot;joined_classification&quot; = &quot;classification&quot; AND &#xd;&#xa;                (&#xd;&#xa;                    length(&quot;joined_name_base&quot;) > length(&quot;name_base&quot;) OR&#xd;&#xa;                    (&#xd;&#xa;                        length(&quot;joined_name_base&quot;) = length(&quot;name_base&quot;) AND &#xd;&#xa;                        with_variable(&#xd;&#xa;                            'id_real_2', to_real(if(&quot;joined_osm_id&quot; = 'unknown', '0', &quot;joined_osm_id&quot;)),&#xd;&#xa;                            with_variable(&#xd;&#xa;                                'id_real', to_real(if(&quot;osm_id&quot; = 'unknown', '0', &quot;osm_id&quot;)),&#xd;&#xa;                                if(@id_real_2 = @id_real, &quot;joined_fid&quot; > &quot;fid&quot;, @id_real_2 > @id_real)&#xd;&#xa;                            )&#xd;&#xa;                        )&#xd;&#xa;                    )&#xd;&#xa;                )&#xd;&#xa;            )&#xd;&#xa;        )&#xd;&#xa;    THEN 1&#xd;&#xa;    ELSE 0&#xd;&#xa;END"/>
          </Option>
        </Option>
        <Option name="INPUT" type="List">
          <Option type="Map">
            <Option name="child_id" type="QString" value="native:joinattributesbylocation_6"/>
            <Option name="output_name" type="QString" value="OUTPUT"/>
            <Option name="source" type="int" value="1"/>
          </Option>
        </Option>
      </Option>
    </Option>
