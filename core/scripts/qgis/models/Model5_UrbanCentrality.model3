            <Option name="static_value" type="QString" value="IF(&#xd;&#xa;  &quot;total_intensity&quot; >= @minimum_intensity_threshold_for_level_3_centralities_total_intensity_values_range_from_0_to_25 AND &#xd;&#xa;  aggregate(&#xd;&#xa;    layer:=@layer, &#xd;&#xa;    aggregate:='count', &#xd;&#xa;    expression:=$id, &#xd;&#xa;    filter:=&quot;total_intensity&quot; >= @minimum_intensity_threshold_for_level_3_centralities_total_intensity_values_range_from_0_to_25 &#xd;&#xa;            AND distance($geometry, geometry(@parent)) &lt;= @minimum_distance_between_level_3_centralities_if_grid_seperation_is_insufficient_m &#xd;&#xa;            AND &quot;total_intensity&quot; > attribute(@parent, 'total_intensity')&#xd;&#xa;  ) = 0, &#xd;&#xa;  1, &#xd;&#xa;  0&#xd;&#xa;)"/>
          </Option>
        </Option>
        <Option name="INPUT" type="List">
