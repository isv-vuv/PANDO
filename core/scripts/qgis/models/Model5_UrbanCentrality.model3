        <Option name="FORMULA" type="List">
          <Option type="Map">
            <Option name="source" type="int" value="2"/>
            <Option name="static_value" type="QString" value="CASE&#xd;&#xa;WHEN &quot;amenity&quot; = 'courthouse' THEN 4&#xd;&#xa;WHEN &quot;office&quot; = 'government' THEN 3&#xd;&#xa;WHEN &quot;office&quot; = 'employment_agency' THEN 3&#xd;&#xa;WHEN &quot;amenity&quot; = 'townhall' THEN 2&#xd;&#xa;WHEN &quot;amenity&quot; = 'bank' THEN 1&#xd;&#xa;WHEN &quot;amenity&quot; = 'post_office' THEN 1&#xd;&#xa;WHEN &quot;amenity&quot; = 'university' THEN 4&#xd;&#xa;WHEN &quot;amenity&quot; = 'college' THEN 3&#xd;&#xa;WHEN &quot;amenity&quot; = 'school' THEN 2&#xd;&#xa;WHEN &quot;amenity&quot; = 'kindergarten' THEN 2&#xd;&#xa;WHEN &quot;shop&quot; = 'mall' THEN 4&#xd;&#xa;WHEN &quot;shop&quot; = 'department_store' THEN 2&#xd;&#xa;WHEN &quot;amenity&quot; = 'marketplace' THEN 3&#xd;&#xa;WHEN &quot;shop&quot; = 'chemist' THEN 2&#xd;&#xa;WHEN &quot;shop&quot; = 'general' THEN 2&#xd;&#xa;WHEN &quot;shop&quot; = 'beverages' THEN 2&#xd;&#xa;WHEN &quot;shop&quot; = 'supermarket' THEN 2&#xd;&#xa;WHEN &quot;shop&quot; = 'bakery' THEN 1&#xd;&#xa;WHEN &quot;shop&quot; = 'butcher' THEN 1&#xd;&#xa;WHEN &quot;shop&quot; = 'convenience' THEN 1&#xd;&#xa;WHEN &quot;shop&quot; = 'kiosk' THEN 1&#xd;&#xa;WHEN &quot;tourism&quot; = 'aquarium' THEN 4&#xd;&#xa;WHEN &quot;amenity&quot; = 'conference_centre' THEN 4&#xd;&#xa;WHEN &quot;amenity&quot; = 'concert_hall' THEN 4&#xd;&#xa;WHEN &quot;tourism&quot; = 'gallery' THEN 4&#xd;&#xa;WHEN &quot;amenity&quot; = 'exhibition_centre' THEN 4&#xd;&#xa;WHEN &quot;tourism&quot; = 'museum' THEN 4&#xd;&#xa;WHEN &quot;amenity&quot; = 'theatre' THEN 4&#xd;&#xa;WHEN &quot;amenity&quot; = 'planetarium' THEN 4&#xd;&#xa;WHEN &quot;leisure&quot; = 'stadium' THEN 4&#xd;&#xa;WHEN &quot;tourism&quot; = 'theme_park' THEN 4&#xd;&#xa;WHEN &quot;amenity&quot; = 'events_venue' THEN 4&#xd;&#xa;WHEN &quot;tourism&quot; = 'zoo' THEN 4&#xd;&#xa;WHEN &quot;amenity&quot; = 'library' THEN 3&#xd;&#xa;WHEN &quot;leisure&quot; = 'water_park' THEN 3&#xd;&#xa;WHEN &quot;amenity&quot; = 'cinema' THEN 3&#xd;&#xa;WHEN &quot;amenity&quot; = 'music_school' THEN 3&#xd;&#xa;WHEN &quot;leisure&quot; = 'sports_centre' THEN 2&#xd;&#xa;WHEN &quot;amenity&quot; = 'public_bath' THEN 3&#xd;&#xa;WHEN &quot;amenity&quot; = 'community_centre' THEN 3&#xd;&#xa;WHEN &quot;amenity&quot; = 'place_of_worship' THEN 2&#xd;&#xa;WHEN &quot;leisure&quot; = 'sports_hall' THEN 2&#xd;&#xa;WHEN &quot;amenity&quot; = 'clinic' THEN 3&#xd;&#xa;WHEN &quot;healthcare&quot; = 'clinic' THEN 3&#xd;&#xa;WHEN &quot;amenity&quot; = 'hospital' THEN 3&#xd;&#xa;WHEN &quot;healthcare&quot; = 'hospital' THEN 3&#xd;&#xa;WHEN &quot;amenity&quot; = 'pharmacy' THEN 2&#xd;&#xa;WHEN &quot;healthcare&quot; = 'pharmacy' THEN 2&#xd;&#xa;WHEN &quot;amenity&quot; = 'doctors' THEN 2&#xd;&#xa;WHEN &quot;healthcare&quot; = 'doctor' THEN 2&#xd;&#xa;WHEN &quot;amenity&quot; = 'dentist' THEN 2&#xd;&#xa;WHEN &quot;healthcare&quot; = 'dentist' THEN 2&#xd;&#xa;WHEN &quot;healthcare&quot; = 'centre' THEN 2&#xd;&#xa;WHEN &quot;amenity&quot; = 'social_facility' THEN 2&#xd;&#xa;WHEN &quot;amenity&quot; = 'nursing_home' THEN 2&#xd;&#xa;WHEN &quot;amenity&quot; = 'youth_centre' THEN 2&#xd;&#xa;WHEN &quot;amenity&quot; = 'social_centre' THEN 2&#xd;&#xa;ELSE -1&#xd;&#xa;END"/>
          </Option>
        </Option>
        <Option name="INPUT" type="List">
