      <Option name="outputs_collapsed" type="bool" value="true"/>
      <Option name="parameters_collapsed" type="bool" value="true"/>
      <Option name="params" type="Map">
        <Option name="INPUT_DATASOURCES" type="List">
          <Option type="Map">
            <Option name="child_id" type="QString" value="native:joinattributesbylocation_2"/>
            <Option name="output_name" type="QString" value="OUTPUT"/>
            <Option name="source" type="int" value="1"/>
          </Option>
          <Option type="Map">
            <Option name="child_id" type="QString" value="native:joinattributesbylocation_3"/>
            <Option name="output_name" type="QString" value="OUTPUT"/>
            <Option name="source" type="int" value="1"/>
          </Option>
        </Option>
        <Option name="INPUT_GEOMETRY_CRS" type="List">
          <Option type="Map">
            <Option name="parameter_name" type="QString" value="local_crs"/>
            <Option name="source" type="int" value="0"/>
          </Option>
        </Option>
        <Option name="INPUT_GEOMETRY_FIELD" type="List">
          <Option type="Map">
            <Option name="source" type="int" value="2"/>
            <Option name="static_value" type="QString" value="geometry"/>
          </Option>
        </Option>
        <Option name="INPUT_GEOMETRY_TYPE" type="List">
          <Option type="Map">
            <Option name="source" type="int" value="2"/>
            <Option name="static_value" type="int" value="4"/>
          </Option>
        </Option>
        <Option name="INPUT_QUERY" type="List">
          <Option type="Map">
            <Option name="source" type="int" value="2"/>
            <Option name="static_value" type="QString" value="SELECT &#xa;  g.geometry AS geometry,&#xa;  g.fid AS fid,&#xa;  g.NO AS ZONENO,&#xa;  g.NAME AS Name,&#xa;  g.MAINZONENO AS MAINZONENO,&#xa;  COALESCE(g.TypeNo_2, g.TYPENO) AS TypeNo,&#xa;  g.POP AS POP,&#xa;  g.NO_E2 AS NO_E2,&#xa;  g.NO_E1 AS NO_E1,&#xa;  g.NO_E0 AS NO_E0,&#xa;  g.&quot;Zone Type&quot; AS Zone_Type,&#xa;  COALESCE(g.XCoord, ST_X(ST_Centroid(g.geometry))) AS XCoord,&#xa;  COALESCE(g.YCoord, ST_Y(ST_Centroid(g.geometry))) AS YCoord,&#xa;  g.total_intensity AS Total_Intensity,&#xa;  g.healthcare AS Healthcare,&#xa;  g.leisure AS Leisure,&#xa;  g.retail AS Retail,&#xa;  g.education AS Education,&#xa;  g.government AS Government,&#xa;  g.p_healthcare AS P_Healthcare,&#xa;  g.p_leisure AS P_Leisure,&#xa;  g.p_retail AS P_Retail,&#xa;  g.p_education AS P_Education,&#xa;  g.p_government AS P_Government,&#xa;  g.entropy AS Entropy,&#xa;  g.entropy_index AS Entropy_Index,&#xa;  COALESCE(p.Num_Healthcare, 0) AS Num_Healthcare,&#xa;  COALESCE(p.Num_Healthcare_O, 0) AS Num_Healthcare_O,&#xa;  COALESCE(p.Num_Healthcare_N, 0) AS Num_Healthcare_N,&#xa;  COALESCE(p.Num_Healthcare_M, 0) AS Num_Healthcare_M,&#xa;  COALESCE(p.Num_Government, 0) AS Num_Government,&#xa;  COALESCE(p.Num_Government_C, 0) AS Num_Government_C,&#xa;  COALESCE(p.Num_Government_B, 0) AS Num_Government_B,&#xa;  COALESCE(p.Num_Government_A, 0) AS Num_Government_A,&#xa;  COALESCE(p.Num_Education, 0) AS Num_Education,&#xa;  COALESCE(p.Num_Education_F, 0) AS Num_Education_F,&#xa;  COALESCE(p.Num_Education_E, 0) AS Num_Education_E,&#xa;  COALESCE(p.Num_Education_D, 0) AS Num_Education_D,&#xa;  COALESCE(p.Num_Retail, 0) AS Num_Retail,&#xa;  COALESCE(p.Num_Retail_T, 0) AS Num_Retail_T,&#xa;  COALESCE(p.Num_Retail_S, 0) AS Num_Retail_S,&#xa;  COALESCE(p.Num_Retail_R, 0) AS Num_Retail_R,&#xa;  COALESCE(p.Num_Leisure, 0) AS Num_Leisure,&#xa;  COALESCE(p.Num_Leisure_L, 0) AS Num_Leisure_L,&#xa;  COALESCE(p.Num_Leisure_K, 0) AS Num_Leisure_K,&#xa;  COALESCE(p.Num_Leisure_J, 0) AS Num_Leisure_J&#xa;FROM input1 g&#xa;LEFT JOIN (&#xa;  SELECT &#xa;    NO,&#xa;    COUNT(CASE WHEN sector = 'HEALTHCARE' THEN 1 END) AS Num_Healthcare,&#xa;    COUNT(CASE WHEN sector = 'HEALTHCARE' AND classification = 'O' THEN 1 END) AS Num_Healthcare_O,&#xa;    COUNT(CASE WHEN sector = 'HEALTHCARE' AND classification = 'N' THEN 1 END) AS Num_Healthcare_N,&#xa;    COUNT(CASE WHEN sector = 'HEALTHCARE' AND classification = 'M' THEN 1 END) AS Num_Healthcare_M,&#xa;    COUNT(CASE WHEN sector = 'GOVERNMENT' THEN 1 END) AS Num_Government,&#xa;    COUNT(CASE WHEN sector = 'GOVERNMENT' AND classification = 'C' THEN 1 END) AS Num_Government_C,&#xa;    COUNT(CASE WHEN sector = 'GOVERNMENT' AND classification = 'B' THEN 1 END) AS Num_Government_B,&#xa;    COUNT(CASE WHEN sector = 'GOVERNMENT' AND classification = 'A' THEN 1 END) AS Num_Government_A,&#xa;    COUNT(CASE WHEN sector = 'EDUCATION' THEN 1 END) AS Num_Education,&#xa;    COUNT(CASE WHEN sector = 'EDUCATION' AND classification = 'F' THEN 1 END) AS Num_Education_F,&#xa;    COUNT(CASE WHEN sector = 'EDUCATION' AND classification = 'E' THEN 1 END) AS Num_Education_E,&#xa;    COUNT(CASE WHEN sector = 'EDUCATION' AND classification = 'D' THEN 1 END) AS Num_Education_D,&#xa;    COUNT(CASE WHEN sector = 'RETAIL' THEN 1 END) AS Num_Retail,&#xa;    COUNT(CASE WHEN sector = 'RETAIL' AND classification = 'T' THEN 1 END) AS Num_Retail_T,&#xa;    COUNT(CASE WHEN sector = 'RETAIL' AND classification = 'S' THEN 1 END) AS Num_Retail_S,&#xa;    COUNT(CASE WHEN sector = 'RETAIL' AND classification = 'R' THEN 1 END) AS Num_Retail_R,&#xa;    COUNT(CASE WHEN sector = 'LEISURE' THEN 1 END) AS Num_Leisure,&#xa;    COUNT(CASE WHEN sector = 'LEISURE' AND classification = 'L' THEN 1 END) AS Num_Leisure_L,&#xa;    COUNT(CASE WHEN sector = 'LEISURE' AND classification = 'K' THEN 1 END) AS Num_Leisure_K,&#xa;    COUNT(CASE WHEN sector = 'LEISURE' AND classification = 'J' THEN 1 END) AS Num_Leisure_J&#xa;  FROM input2&#xa;  GROUP BY NO&#xa;) p ON g.NO = p.NO"/>
          </Option>
        </Option>
        <Option name="INPUT_UID_FIELD" type="List">
          <Option type="Map">
            <Option name="source" type="int" value="2"/>
            <Option name="static_value" type="invalid"/>
          </Option>
        </Option>
      </Option>
    </Option>
